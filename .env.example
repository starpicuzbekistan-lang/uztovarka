# Brauzerga chiqadigan qiymatlar (VITE_ bilan boshlanadi). Bular ommaviy: URL va "anon" kalit.
# Supabase → Project Settings → API dan oling.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# DIQQAT: SERVICE ROLE kalitini bu yerga YOZMANG. U faqat Supabase Edge Function ichida
